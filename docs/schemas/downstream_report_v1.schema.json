{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAUGE Climate downstream ladder report v1",
  "type": "object",
  "required": ["schema", "metadata", "records", "plans"],
  "properties": {
    "schema": {"const": "gauge_climate.downstream.v1"},
    "metadata": {
      "type": "object",
      "required": [
        "seeds", "alpha", "confidence", "primary_contrast",
        "secondary_source_contrast", "restored_real_role", "matching_policy",
        "transform_policy", "task", "callback_determinism_audited"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "holdout", "seed", "arm", "metrics", "block_metrics",
          "counts_by_label", "counts_by_stratum"
        ],
        "properties": {
          "holdout": {"type": "string"},
          "seed": {"type": "integer"},
          "arm": {
            "enum": [
              "A0_no_aug", "A1_class_weight", "A2_copy", "A3_copy_geo",
              "A4_generated", "A5_generated_geo", "A6_restored_real",
              "A7_restored_real_geo"
            ]
          },
          "metrics": {"type": "object"},
          "block_metrics": {"type": "object"},
          "counts_by_label": {"type": "object"},
          "counts_by_stratum": {"type": "object"}
        }
      }
    },
    "plans": {"type": "object"}
  },
  "additionalProperties": false
}
